{#
/**
 * @file
 * BREBO — definitieve volledige weergave van contenttype Dienst.
 *
 * Plaats als:
 * templates/content/node--dienst--full.html.twig
 */
#}

{% set intro = content.field_intro|render %}
{% set body = content.field_body|render %}
{% set key_points = content.field_key_points|render %}
{% set related_projects = content.field_related_projects|render %}

<article{{ attributes.addClass('service-detail') }}>

  <header class="service-detail__hero">

    {# Afbeeldingsvelden niet met striptags testen: een afbeelding bevat geen tekst. #}
    {% if node.field_hero_afbeelding is not empty %}
      <div class="service-detail__hero-image">
        {{ content.field_hero_afbeelding }}
      </div>
    {% endif %}

    <div class="service-detail__hero-overlay" aria-hidden="true"></div>

    <div class="service-detail__hero-inner">
      <p class="service-detail__eyebrow">{{ 'Uw situatie'|t }}</p>

      <h1 class="service-detail__title">{{ node.label }}</h1>

      {% if intro|striptags|trim %}
        <div class="service-detail__lead">
          {{ intro }}
        </div>
      {% endif %}
    </div>

  </header>

  <main class="service-detail__main">

    {% if body|striptags|trim %}
      <section class="service-detail__body">
        {{ body }}
      </section>
    {% endif %}

    {% if key_points|striptags|trim %}
      <section class="service-detail__key-points" aria-labelledby="dienst-kernpunten">
        <div class="service-detail__section-heading">
          <p class="service-detail__section-eyebrow">
            {{ 'Wat heeft u nu nodig?'|t }}
          </p>

          <h2 id="dienst-kernpunten">
            {{ 'Zo helpt BREBO u verder'|t }}
          </h2>
        </div>

        <div class="service-detail__key-points-list">
          {{ key_points }}
        </div>
      </section>
    {% endif %}

    <section class="service-detail__journey" aria-labelledby="dienst-klantreis">
      <div class="service-detail__section-heading">
        <p class="service-detail__section-eyebrow">
          {{ 'Uw gebouw. Uw moment.'|t }}
        </p>

        <h2 id="dienst-klantreis">
          {{ 'U kunt instappen waar u ons nodig heeft'|t }}
        </h2>

        <p>
          {{ 'Niet ieder project begint bij BREBO. Misschien wilt u eerst weten wat er speelt, heeft u de aanpak al bepaald of is het werk zelfs al gestart. We sluiten aan op uw situatie en nemen alleen de rol die nodig is.'|t }}
        </p>
      </div>

      <ol class="service-detail__journey-steps">
        <li><span>01</span><strong>{{ 'Begrijpen'|t }}</strong><small>{{ 'Wat speelt er aan uw gebouw?'|t }}</small></li>
        <li><span>02</span><strong>{{ 'Bepalen'|t }}</strong><small>{{ 'Welke aanpak past bij de opgave?'|t }}</small></li>
        <li><span>03</span><strong>{{ 'Voorbereiden'|t }}</strong><small>{{ 'Zijn afspraken, stukken en kosten helder?'|t }}</small></li>
        <li><span>04</span><strong>{{ 'Uitvoeren'|t }}</strong><small>{{ 'Het werk gaat van start.'|t }}</small></li>
        <li class="service-detail__journey-step--accent"><span>05</span><strong>{{ 'Begeleiden'|t }}</strong><small>{{ 'Wie bewaakt tijdens het werk uw belang?'|t }}</small></li>
        <li><span>06</span><strong>{{ 'Opleveren'|t }}</strong><small>{{ 'Is uitgevoerd wat is afgesproken?'|t }}</small></li>
        <li><span>07</span><strong>{{ 'Beheren'|t }}</strong><small>{{ 'Wat vraagt het gebouw daarna?'|t }}</small></li>
      </ol>

      <p class="service-detail__journey-note">
        {{ 'Loopt uw project al? Ook dan kunt u rechtstreeks bij BREBO instappen voor onafhankelijke begeleiding, controle of oplevering.'|t }}
      </p>
    </section>

    <section class="service-detail__lens" aria-labelledby="dienst-lens">
      <div class="service-detail__lens-intro">
        <p class="service-detail__section-eyebrow">
          {{ 'De BREBO Lens'|t }}
        </p>

        <h2 id="dienst-lens">
          {{ 'Van inzicht naar een beheersbaar resultaat'|t }}
        </h2>

        <p>
          {{ 'We kijken naar uw gebouw, de opgave en de fase waarin u zich bevindt. Zo ontstaat een aanpak die past bij wat er werkelijk nodig is, zonder dat u meer diensten hoeft af te nemen dan nodig.'|t }}
        </p>
      </div>

      <div class="service-detail__lens-steps">

        <div class="service-detail__lens-step">
          <span class="service-detail__lens-number">01</span>
          <div>
            <h3>{{ 'Inzicht'|t }}</h3>
            <p>{{ 'We maken helder wat er speelt, welke risico’s er zijn en welke informatie nodig is om een goede keuze te maken.'|t }}</p>
          </div>
        </div>

        <div class="service-detail__lens-step">
          <span class="service-detail__lens-number">02</span>
          <div>
            <h3>{{ 'Regie'|t }}</h3>
            <p>{{ 'We brengen keuzes, afspraken, partijen, planning en kosten samen en bewaken de samenhang.'|t }}</p>
          </div>
        </div>

        <div class="service-detail__lens-step">
          <span class="service-detail__lens-number">03</span>
          <div>
            <h3>{{ 'Realisatie'|t }}</h3>
            <p>{{ 'Als uitvoering aan de orde is, kan BREBO die organiseren, begeleiden of onafhankelijk controleren — passend bij uw opdracht.'|t }}</p>
          </div>
        </div>

      </div>
    </section>

    {% if related_projects|striptags|trim %}
      <section class="service-detail__projects" aria-labelledby="dienst-projecten">
        <div class="service-detail__section-heading">
          <p class="service-detail__section-eyebrow">
            {{ 'In de praktijk'|t }}
          </p>

          <h2 id="dienst-projecten">
            {{ 'Gerelateerde projecten'|t }}
          </h2>
        </div>

        <div class="service-detail__projects-grid">
          {{ related_projects }}
        </div>
      </section>
    {% endif %}

  </main>

  <section class="service-detail__cta">
    <div class="service-detail__cta-inner">
      <div class="service-detail__cta-copy">
        <p class="service-detail__cta-eyebrow">
          {{ 'Uw situatie bespreken'|t }}
        </p>

        <h2>
          {{ 'Waar staat u nu met uw gebouw of project?'|t }}
        </h2>
      </div>

      <a class="service-detail__cta-button" href="/offerte-aanvragen">
        <span>{{ 'Bespreek uw situatie'|t }}</span>
        <span class="service-detail__cta-arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>

</article>
