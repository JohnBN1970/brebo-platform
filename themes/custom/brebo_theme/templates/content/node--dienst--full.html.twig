{#
/**
 * @file
 * Vraagstukgerichte volledige weergave van contenttype Dienst.
 *
 * Het technische contenttype blijft `dienst`, maar de bezoeker wordt geleid
 * vanuit het gebouwvraagstuk, herkenbare signalen en oplossingsrichtingen.
 */
#}

{% set intro = content.field_intro|render %}
{% set body = content.field_body|render %}
{% set building_issue = content.field_building_issue|render %}
{% set signals = content.field_signals|render %}
{% set causes = content.field_causes|render %}
{% set consequences = content.field_consequences|render %}
{% set solution_directions = content.field_solution_directions|render %}
{% set results = content.field_results|render %}
{% set related_projects = content.field_related_projects|render %}
{% set faq = content.field_faq|render %}

<article{{ attributes.addClass('service-detail', 'question-detail') }}>

  <header class="service-detail__hero">
    {% if node.field_hero_afbeelding is not empty %}
      <div class="service-detail__hero-image">
        {{ content.field_hero_afbeelding }}
      </div>
    {% endif %}

    <div class="service-detail__hero-overlay" aria-hidden="true"></div>

    <div class="service-detail__hero-inner">
      <p class="service-detail__eyebrow">{{ 'Vraagstuk voor uw gebouw'|t }}</p>
      <h1 class="service-detail__title">{{ node.label }}</h1>

      {% if intro|striptags|trim %}
        <div class="service-detail__lead">
          {{ intro }}
        </div>
      {% endif %}
    </div>
  </header>

  <main class="service-detail__main">

    {% if building_issue|striptags|trim %}
      <section class="service-detail__body question-detail__issue" aria-labelledby="vraagstuk-gebouw">
        <div class="service-detail__section-heading">
          <p class="service-detail__section-eyebrow">{{ 'De situatie'|t }}</p>
          <h2 id="vraagstuk-gebouw">{{ 'Waar loopt het gebouw tegenaan?'|t }}</h2>
        </div>
        {{ building_issue }}
      </section>
    {% elseif body|striptags|trim %}
      <section class="service-detail__body question-detail__issue" aria-labelledby="vraagstuk-gebouw">
        <div class="service-detail__section-heading">
          <p class="service-detail__section-eyebrow">{{ 'De situatie'|t }}</p>
          <h2 id="vraagstuk-gebouw">{{ 'Waar loopt het gebouw tegenaan?'|t }}</h2>
        </div>
        {{ body }}
      </section>
    {% endif %}

    {% if signals|striptags|trim %}
      <section class="service-detail__key-points question-detail__signals" aria-labelledby="vraagstuk-signalen">
        <div class="service-detail__section-heading">
          <p class="service-detail__section-eyebrow">{{ 'Herkenning'|t }}</p>
          <h2 id="vraagstuk-signalen">{{ 'Waaraan is het vraagstuk herkenbaar?'|t }}</h2>
        </div>
        <div class="service-detail__key-points-list">
          {{ signals }}
        </div>
      </section>
    {% endif %}

    {% if causes|striptags|trim %}
      <section class="service-detail__key-points question-detail__causes" aria-labelledby="vraagstuk-oorzaken">
        <div class="service-detail__section-heading">
          <p class="service-detail__section-eyebrow">{{ 'Analyse'|t }}</p>
          <h2 id="vraagstuk-oorzaken">{{ 'Mogelijke oorzaken'|t }}</h2>
        </div>
        <div class="service-detail__key-points-list">
          {{ causes }}
        </div>
      </section>
    {% endif %}

    {% if consequences|striptags|trim %}
      <section class="service-detail__key-points question-detail__consequences" aria-labelledby="vraagstuk-gevolgen">
        <div class="service-detail__section-heading">
          <p class="service-detail__section-eyebrow">{{ 'Risico en impact'|t }}</p>
          <h2 id="vraagstuk-gevolgen">{{ 'Gevolgen voor gebouw, gebruik en onderhoud'|t }}</h2>
        </div>
        <div class="service-detail__key-points-list">
          {{ consequences }}
        </div>
      </section>
    {% endif %}

    {% if solution_directions|striptags|trim %}
      <section class="service-detail__body question-detail__solutions" aria-labelledby="vraagstuk-oplossingen">
        <div class="service-detail__section-heading">
          <p class="service-detail__section-eyebrow">{{ 'Keuzerichting'|t }}</p>
          <h2 id="vraagstuk-oplossingen">{{ 'Welke oplossingsrichtingen zijn mogelijk?'|t }}</h2>
        </div>
        {{ solution_directions }}
      </section>
    {% endif %}

    <section class="service-detail__lens" aria-labelledby="dienst-lens">
      <div class="service-detail__lens-intro">
        <p class="service-detail__section-eyebrow">{{ 'De BREBO Lens'|t }}</p>
        <h2 id="dienst-lens">{{ 'Van inzicht naar een beheersbaar resultaat'|t }}</h2>
        <p>
          {{ 'De complete buitenzijde van het gebouw vormt het vertrekpunt. Zo ontstaat één samenhangend plan met één aanspreekpunt en één planning.'|t }}
        </p>
      </div>

      <div class="service-detail__lens-steps">
        <div class="service-detail__lens-step">
          <span class="service-detail__lens-number">01</span>
          <div>
            <h3>{{ 'Inzicht'|t }}</h3>
            <p>{{ 'De technische staat, aandachtspunten en onderlinge samenhang worden helder in beeld gebracht.'|t }}</p>
          </div>
        </div>

        <div class="service-detail__lens-step">
          <span class="service-detail__lens-number">02</span>
          <div>
            <h3>{{ 'Controle'|t }}</h3>
            <p>{{ 'Het inzicht wordt vertaald naar duidelijke keuzes, een beheersbare planning en afgestemde disciplines.'|t }}</p>
          </div>
        </div>

        <div class="service-detail__lens-step">
          <span class="service-detail__lens-number">03</span>
          <div>
            <h3>{{ 'Realisatie'|t }}</h3>
            <p>{{ 'Uitvoering, kwaliteit en voortgang worden bewaakt tot en met de oplevering.'|t }}</p>
          </div>
        </div>
      </div>
    </section>

    {% if results|striptags|trim %}
      <section class="service-detail__key-points question-detail__results" aria-labelledby="vraagstuk-resultaten">
        <div class="service-detail__section-heading">
          <p class="service-detail__section-eyebrow">{{ 'Beoogd resultaat'|t }}</p>
          <h2 id="vraagstuk-resultaten">{{ 'Wat levert de gekozen aanpak het gebouw op?'|t }}</h2>
        </div>
        <div class="service-detail__key-points-list">
          {{ results }}
        </div>
      </section>
    {% endif %}

    {% if related_projects|striptags|trim %}
      <section class="service-detail__projects" aria-labelledby="dienst-projecten">
        <div class="service-detail__section-heading">
          <p class="service-detail__section-eyebrow">{{ 'In de praktijk'|t }}</p>
          <h2 id="dienst-projecten">{{ 'Gerelateerde projecten'|t }}</h2>
        </div>
        <div class="service-detail__projects-grid">
          {{ related_projects }}
        </div>
      </section>
    {% endif %}

    {% if brebo_related_questions %}
      <section class="service-detail__projects question-detail__related" aria-labelledby="gerelateerde-vraagstukken">
        <div class="service-detail__section-heading">
          <p class="service-detail__section-eyebrow">{{ 'Verder onderzoeken'|t }}</p>
          <h2 id="gerelateerde-vraagstukken">{{ 'Gerelateerde vraagstukken voor het gebouw'|t }}</h2>
        </div>
        <div class="service-detail__projects-grid question-detail__related-grid">
          {% for item in brebo_related_questions %}
            <article class="question-detail__related-card">
              <h3><a href="{{ item.url }}">{{ item.title }}</a></h3>
              <a class="question-detail__related-link" href="{{ item.url }}">
                {{ 'Bekijk dit vraagstuk'|t }} <span aria-hidden="true">→</span>
              </a>
            </article>
          {% endfor %}
        </div>
      </section>
    {% endif %}

    {% if faq|striptags|trim %}
      <section class="service-detail__body question-detail__faq" aria-labelledby="vraagstuk-faq">
        <div class="service-detail__section-heading">
          <p class="service-detail__section-eyebrow">{{ 'Kennis'|t }}</p>
          <h2 id="vraagstuk-faq">{{ 'Veelgestelde vragen'|t }}</h2>
        </div>
        {{ faq }}
      </section>
    {% endif %}

  </main>

  <section class="service-detail__cta">
    <div class="service-detail__cta-inner">
      <div class="service-detail__cta-copy">
        <p class="service-detail__cta-eyebrow">{{ 'Uw gebouw centraal'|t }}</p>
        <h2>{{ 'Bespreek de situatie van uw gebouw'|t }}</h2>
      </div>

      <a class="service-detail__cta-button" href="/contact">
        <span>{{ 'Plan een adviesgesprek'|t }}</span>
        <span class="service-detail__cta-arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>

</article>
