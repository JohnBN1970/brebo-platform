<?php

/**
 * @file
 * Theme hooks and preprocess functions for BREBO Theme.
 */

/**
 * Implements hook_preprocess_html().
 */
function brebo_theme_preprocess_html(array &$variables): void {
  $paths_with_embedded_h1 = [
    '/uw-gebouw',
    '/projecten',
    '/klantenservice',
  ];

  $path = rtrim(\Drupal::request()->getPathInfo(), '/') ?: '/';
  if (in_array($path, $paths_with_embedded_h1, TRUE)) {
    $variables['attributes']['class'][] = 'brebo-has-embedded-page-title';
  }
}

/**
 * Implements hook_preprocess_node().
 */
function brebo_theme_preprocess_node(array &$variables): void {
  $node = $variables['node'] ?? NULL;

  if (
    $node &&
    $node->bundle() === 'dienst' &&
    ($variables['view_mode'] ?? '') === 'full'
  ) {
    $variables['#attached']['library'][] = 'brebo_theme/service-detail';
  }
}
