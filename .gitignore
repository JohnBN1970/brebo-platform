###############################################################################
# BREBO Platform - Git Ignore
###############################################################################

#
# Drupal runtime and uploads
#
sites/*/files/
sites/*/private/
sites/simpletest/

#
# Local configuration and secrets
#
sites/*/settings.local.php
sites/*/services.local.yml
.env
.env.*

#
# IDE
#
.vscode/
.idea/

#
# Operating system
#
.DS_Store
Thumbs.db
*~

#
# Logs
#
*.log
error_log

#
# Temporary files and caches
#
tmp/
cache/
.phpunit.result.cache

#
# Node
#
node_modules/

#
# PHPUnit local configuration
#
phpunit.xml

#
# Backups and database exports
#
*.sql
*.sql.gz
backup/
backups/

#
# Local Composer executable
#
composer.phar

#
# Git credentials
#
.git-credentials

###############################################################################
# Important BREBO project decisions
#
# - sites/*/settings.php stays in Git.
# - Sensitive settings belong in settings.local.php.
# - vendor/ currently stays in Git for the Hostinger deployment workflow.
###############################################################################
