# Composer-built dependencies and Drupal scaffold.
/vendor/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/
/web/libraries/

# Runtime and environment-specific Drupal files.
/web/sites/*/files/
/web/sites/*/private/
/web/sites/simpletest/
/web/sites/*/settings.local.php
/web/sites/*/services.local.yml

# Secrets, databases, logs and local tooling.
.env
.env.*
*.sql
*.sql.gz
*.log
.phpunit.result.cache
/.idea/
/.vscode/
.DS_Store
