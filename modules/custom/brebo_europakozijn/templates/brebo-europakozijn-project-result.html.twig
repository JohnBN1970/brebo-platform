<section class="ek-configurator ek-project-result">
  <header class="ek-configurator__header">
    <p class="ek-configurator__eyebrow">BREBO × Europakozijn</p>
    <h1>Herkende projectinformatie</h1>
    <p>BREBO Office heeft de aangeleverde projectstukken ontvangen en inhoudelijk uitgelezen voor zover dat betrouwbaar kon.</p>
  </header>

  <section class="ek-price-explanation">
    <h2>Eerst controleren, dan pas gebruiken</h2>
    <p><strong>{{ result.principle }}</strong></p>
    <p>Ontbrekende of onduidelijke informatie blijft bewust open. De gegevens hieronder zijn voorlopige Office-resultaten en nog geen definitieve kozijnstaat of technische goedkeuring.</p>
  </section>

  {% set office = result.office_summary|default({}) %}
  <section class="ek-price-explanation ek-project-result__context">
    <p class="ek-configurator__eyebrow">BREBO OFFICE INTAKE</p>
    <h2>Uitleesstatus projectstukken</h2>
    <p>
      {{ office.documents_read|default(0) }} van {{ office.documents_indexed|default(0) }} documenten inhoudelijk uitgelezen.
    </p>

    {% if result.files|default([]) %}
      {% for file in result.files %}
        {% set office_response = file.office|default({}) %}
        {% set recognition = office_response.recognition|default({}) %}
        {% set documents = recognition.documents|default([]) %}

        <article class="ek-price-explanation ek-project-result__file">
          <h3>{{ file.name }}</h3>
          <p>
            <strong>Overdracht aan Office:</strong>
            {{ office_response.ok|default(false) ? 'ontvangen' : 'niet gelukt' }}
            · <strong>Documenten:</strong> {{ recognition.document_count|default(0) }}
            · <strong>Inhoudelijk uitgelezen:</strong> {{ recognition.extracted_count|default(0) }}
          </p>

          {% if documents %}
            <details open>
              <summary>Uitleesstatus per document</summary>
              <ul>
                {% for document in documents %}
                  <li>
                    <strong>{{ document.filename|default('document') }}</strong>
                    — {{ document.mime_type|default('onbekend type') }}
                    — <strong>{{ document.status|default('onbekend') }}</strong>
                    — zekerheid {{ ((document.confidence|default(0)) * 100)|round }}%
                    {% if document.extractor|default('') %}
                      — {{ document.extractor }}
                    {% endif %}
                  </li>
                {% endfor %}
              </ul>
            </details>

            {% for document in documents %}
              {% if document.excerpt|default('') %}
                <details>
                  <summary>Uitleesfragment — {{ document.filename|default('document') }}</summary>
                  <p>{{ document.excerpt }}</p>
                </details>
              {% endif %}
            {% endfor %}
          {% else %}
            <p><strong>Nog geen inhoudelijke Office-resultaten beschikbaar.</strong></p>
          {% endif %}
        </article>
      {% endfor %}
    {% endif %}
  </section>

  <section class="ek-price-explanation">
    <h2>Volgende stap</h2>
    <p>BREBO Office gebruikt deze uitlezing als bron voor de voorlopige projectscope. Aantallen, maatvoering, typen en andere projectinformatie worden pas als voorstel getoond wanneer de bronnen voldoende betrouwbaar aan elkaar gekoppeld kunnen worden.</p>
    <p><a class="ek-configurator__cta" href="/europakozijn/projectstukken">Andere projectstukken aanleveren</a></p>
  </section>
</section>
