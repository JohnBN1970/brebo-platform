      'description' => 'Feitelijke waarneming of onderhoudsvraag.',
      'type' => 'text_long',
      'required' => TRUE,
      'form' => ['type' => 'text_textarea', 'weight' => 10, 'settings' => ['rows' => 6]],
      'view' => ['type' => 'text_default', 'label' => 'above', 'weight' => 10],
    ],
    'field_brebo_meaning' => [
      'label' => 'Betekenis',
      'description' => 'Betekenis en duiding van de waarneming.',
