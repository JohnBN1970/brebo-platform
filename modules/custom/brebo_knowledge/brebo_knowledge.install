<?php

/**
 * Installs the approved knowledge item configuration on existing sites.
 */
function brebo_knowledge_update_11001(): void {
  $config_names = [
    'node.type.brebo_knowledge_item',
    'field.storage.node.field_knowledge_observation',
    'field.storage.node.field_knowledge_meaning',
    'field.storage.node.field_knowledge_risk',
    'field.storage.node.field_knowledge_next_step',
    'field.storage.node.field_knowledge_basis',
    'field.storage.node.field_knowledge_regie',
    'field.storage.node.field_knowledge_realization',
    'field.field.node.brebo_knowledge_item.field_knowledge_observation',
    'field.field.node.brebo_knowledge_item.field_knowledge_meaning',
    'field.field.node.brebo_knowledge_item.field_knowledge_risk',
    'field.field.node.brebo_knowledge_item.field_knowledge_next_step',
    'field.field.node.brebo_knowledge_item.field_knowledge_basis',
    'field.field.node.brebo_knowledge_item.field_knowledge_regie',
    'field.field.node.brebo_knowledge_item.field_knowledge_realization',
    'core.entity_form_display.node.brebo_knowledge_item.default',
  ];

  $module_path = \Drupal::service('extension.list.module')->getPath('brebo_knowledge');
  $source = new \Drupal\Core\Config\FileStorage($module_path . '/config/install');
  $active = \Drupal::service('config.storage');

  $source_names = $source->listAll();
  sort($source_names);
  $expected_names = $config_names;
  sort($expected_names);
  if ($source_names !== $expected_names) {
    $missing = array_values(array_diff($expected_names, $source_names));
    $unexpected = array_values(array_diff($source_names, $expected_names));
    throw new \Drupal\Core\Utility\UpdateException(sprintf(
      'BREBO Knowledge-bronconfiguratie is incompleet of onverwacht. Ontbrekend: %s. Onverwacht: %s.',
      $missing ? implode(', ', $missing) : 'geen',
      $unexpected ? implode(', ', $unexpected) : 'geen',
    ));
  }

  $source_data = $source->readMultiple($config_names);
  if (count($source_data) !== count($config_names)) {
    throw new \Drupal\Core\Utility\UpdateException('BREBO Knowledge-bronconfiguratie kon niet volledig worden gelezen.');
  }

  $existing = [];
  $missing = [];
  $different = [];
  foreach ($config_names as $config_name) {
    if (!$active->exists($config_name)) {
      $missing[] = $config_name;
      continue;
    }

    $existing[] = $config_name;
    $active_data = $active->read($config_name);
    if (!is_array($active_data)) {
      $different[] = $config_name;
      continue;
    }

    unset($active_data['uuid']);
    if (isset($active_data['_core']['default_config_hash'])) {
      unset($active_data['_core']['default_config_hash']);
      if ($active_data['_core'] === []) {
        unset($active_data['_core']);
      }
    }
    if ($active_data !== $source_data[$config_name]) {
      $different[] = $config_name;
    }
  }

  if ($different || ($existing && $missing)) {
    throw new \Drupal\Core\Utility\UpdateException(sprintf(
      'BREBO Knowledge-configuratieconflict. Bestaand: %s. Ontbrekend: %s. Afwijkend: %s. Er is niets gewijzigd.',
      $existing ? implode(', ', $existing) : 'geen',
      $missing ? implode(', ', $missing) : 'geen',
      $different ? implode(', ', $different) : 'geen',
    ));
  }

  if (!$missing) {
    return;
  }

  \Drupal::service('config.installer')->installDefaultConfig('module', 'brebo_knowledge');
  $active = \Drupal::service('config.storage');

  $missing_after = [];
  $different_after = [];
  foreach ($config_names as $config_name) {
    if (!$active->exists($config_name)) {
      $missing_after[] = $config_name;
      continue;
    }

    $active_data = $active->read($config_name);
    if (!is_array($active_data)) {
      $different_after[] = $config_name;
      continue;
    }

    unset($active_data['uuid']);
    if (isset($active_data['_core']['default_config_hash'])) {
      unset($active_data['_core']['default_config_hash']);
      if ($active_data['_core'] === []) {
        unset($active_data['_core']);
      }
    }
    if ($active_data !== $source_data[$config_name]) {
      $different_after[] = $config_name;
    }
  }

  if ($missing_after || $different_after) {
    throw new \Drupal\Core\Utility\UpdateException(sprintf(
      'BREBO Knowledge-nacontrole is mislukt. Ontbrekend: %s. Afwijkend: %s.',
      $missing_after ? implode(', ', $missing_after) : 'geen',
      $different_after ? implode(', ', $different_after) : 'geen',
    ));
  }
}
