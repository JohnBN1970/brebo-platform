  return [
    'field_brebo_stable_id' => [
      'label' => 'Stabiele ID',
      'description' => 'Systeembeheerde, onveranderlijke functionele identifier.',
      'type' => 'string',
      'required' => TRUE,
      'settings' => ['max_length' => 9],
      'form' => ['type' => 'string_textfield', 'weight' => -10, 'settings' => ['size' => 20, 'placeholder' => 'Wordt automatisch toegekend']],
