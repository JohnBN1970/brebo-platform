      'description' => 'Gesloten urgentieduiding.',
      'type' => 'list_string',
      'required' => TRUE,
      'settings' => ['allowed_values' => ['low' => 'Laag', 'normal' => 'Normaal', 'high' => 'Hoog', 'critical' => 'Kritiek']],
      'form' => ['type' => 'options_select', 'weight' => 30],
      'view' => ['type' => 'list_default', 'label' => 'above', 'weight' => 30],
    ],
    'field_brebo_first_step' => [
      'label' => 'Eerste stap',
