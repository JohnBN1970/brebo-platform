<?php

declare(strict_types=1);

/**
 * @file
 * Installatie en updates voor BREBO Knowledge.
 */

use Drupal\Core\Entity\Entity\EntityFormDisplay;
use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\node\Entity\NodeType;

/**
 * Implementeert de eerste functionele uitbreiding van brebo_knowledge.
 */
function brebo_knowledge_update_11001(): void {
  $bundle = 'brebo_knowledge_item';
  $definitions = _brebo_knowledge_11001_field_definitions();

  _brebo_knowledge_11001_preflight($bundle, $definitions);

  $created = [];
  try {
    if (!NodeType::load($bundle)) {
      NodeType::create([
        'type' => $bundle,
        'name' => 'Probleemgerichte kennisbijdrage',
        'description' => 'Probleemgerichte, revisioneerbare BREBO-kennisbijdrage.',
        'new_revision' => TRUE,
        'preview_mode' => 1,
        'display_submitted' => FALSE,
      ])->save();
      $created[] = ['node_type', $bundle];
    }

    foreach ($definitions as $field_name => $definition) {
      if (!FieldStorageConfig::loadByName('node', $field_name)) {
        FieldStorageConfig::create([
          'field_name' => $field_name,
          'entity_type' => 'node',
          'type' => 'text_long',
          'cardinality' => 1,
          'translatable' => TRUE,
        ])->save();
        $created[] = ['field_storage', $field_name];
      }

      if (!FieldConfig::loadByName('node', $bundle, $field_name)) {
        FieldConfig::create([
          'field_name' => $field_name,
          'entity_type' => 'node',
          'bundle' => $bundle,
          'label' => $definition['label'],
          'description' => $definition['description'],
          'required' => $definition['required'],
          'translatable' => TRUE,
        ])->save();
        $created[] = ['field_config', $field_name];
      }
    }

    if (!EntityFormDisplay::load("node.$bundle.default")) {
      $display = EntityFormDisplay::create([
        'targetEntityType' => 'node',
        'bundle' => $bundle,
        'mode' => 'default',
        'status' => TRUE,
      ]);
      foreach (array_keys($definitions) as $weight => $field_name) {
        $display->setComponent($field_name, [
          'type' => 'text_textarea',
          'weight' => $weight,
          'region' => 'content',
          'settings' => ['rows' => 6, 'placeholder' => ''],
          'third_party_settings' => [],
        ]);
      }
      $display->save();
      $created[] = ['form_display', "node.$bundle.default"];
    }
  }
  catch (\Throwable $exception) {
    _brebo_knowledge_11001_rollback($bundle, $created);
    throw new RuntimeException(
      'BREBO-2026-004 kon niet volledig worden geïnstalleerd; nieuw aangemaakte configuratie is teruggedraaid. Oorzaak: ' . $exception->getMessage(),
      0,
      $exception,
    );
  }
}

/**
 * Geeft de exact goedgekeurde velddefinities terug.
 */
function _brebo_knowledge_11001_field_definitions(): array {
  return [
    'field_knowledge_observation' => [
      'label' => 'Waarneming',
      'description' => 'Feitelijke waarneming of onderhoudsvraag.',
      'required' => TRUE,
    ],
    'field_knowledge_meaning' => [
      'label' => 'Betekenis',
      'description' => 'Betekenis en duiding van de waarneming.',
      'required' => TRUE,
    ],
    'field_knowledge_urgency' => [
      'label' => 'Urgentie',
      'description' => 'Urgentie en noodzaak tot handelen.',
      'required' => TRUE,
    ],
    'field_knowledge_first_step' => [
      'label' => 'Eerste stap',
      'description' => 'Aanbevolen eerste onderzoek of eerste handeling.',
      'required' => TRUE,
    ],
    'field_knowledge_risks' => [
      'label' => 'Risico’s',
      'description' => 'Relevante risico’s en mogelijke gevolgen.',
      'required' => TRUE,
    ],
    'field_knowledge_regie' => [
      'label' => 'Advies en doorverwijzing',
      'description' => 'Advies over regie, vervolgstappen of doorverwijzing.',
      'required' => FALSE,
    ],
    'field_knowledge_realization' => [
      'label' => 'Voorwaarden en context',
      'description' => 'Voorwaarden, context en aandachtspunten voor realisatie.',
      'required' => FALSE,
    ],
  ];
}

/**
 * Controleert alle bestaande configuratie voordat iets wordt aangemaakt.
 */
function _brebo_knowledge_11001_preflight(string $bundle, array $definitions): void {
  if ($type = NodeType::load($bundle)) {
    if ($type->label() !== 'Probleemgerichte kennisbijdrage' || !$type->shouldCreateNewRevision()) {
      throw new RuntimeException('Afwijkende configuratie voor node.type.brebo_knowledge_item; update is gestopt zonder wijzigingen.');
    }
  }

  foreach ($definitions as $field_name => $definition) {
    if ($storage = FieldStorageConfig::loadByName('node', $field_name)) {
      if ($storage->getType() !== 'text_long' || $storage->getCardinality() !== 1) {
        throw new RuntimeException(sprintf('Afwijkende veldopslag voor %s; update is gestopt zonder wijzigingen.', $field_name));
      }
    }

    if ($field = FieldConfig::loadByName('node', $bundle, $field_name)) {
      if ($field->label() !== $definition['label'] || $field->isRequired() !== $definition['required']) {
        throw new RuntimeException(sprintf('Afwijkende veldconfiguratie voor %s; update is gestopt zonder wijzigingen.', $field_name));
      }
    }
  }

  if ($display = EntityFormDisplay::load("node.$bundle.default")) {
    foreach (array_keys($definitions) as $field_name) {
      $component = $display->getComponent($field_name);
      if (!$component || ($component['type'] ?? NULL) !== 'text_textarea') {
        throw new RuntimeException(sprintf('Afwijkende formulierconfiguratie voor %s; update is gestopt zonder wijzigingen.', $field_name));
      }
    }
  }
}

/**
 * Verwijdert uitsluitend configuratie die in de mislukte run is aangemaakt.
 */
function _brebo_knowledge_11001_rollback(string $bundle, array $created): void {
  foreach (array_reverse($created) as [$type, $id]) {
    if ($type === 'form_display' && ($entity = EntityFormDisplay::load($id))) {
      $entity->delete();
    }
    elseif ($type === 'field_config' && ($entity = FieldConfig::loadByName('node', $bundle, $id))) {
      $entity->delete();
    }
    elseif ($type === 'field_storage' && ($entity = FieldStorageConfig::loadByName('node', $id))) {
      $entity->delete();
    }
    elseif ($type === 'node_type' && ($entity = NodeType::load($id))) {
      $entity->delete();
    }
  }
}
