      'required' => FALSE,
      'cardinality' => -1,
      'settings' => ['allowed_values' => ['insight' => 'Inzicht', 'direction' => 'Regie', 'realisation' => 'Realisatie']],
      'form' => ['type' => 'options_buttons', 'weight' => 60],
      'view' => ['type' => 'list_default', 'label' => 'above', 'weight' => 60],
    ],
    'field_brebo_lifecycle_status' => [
      'label' => 'Lifecycle-status',
      'description' => 'Functionele status van de kennisbijdrage.',
      'type' => 'list_string',
      'required' => TRUE,
      'settings' => ['allowed_values' => ['concept' => 'Concept', 'published' => 'Gepubliceerd', 'archived' => 'Gearchiveerd']],
