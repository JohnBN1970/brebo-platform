<?php

declare(strict_types=1);

/**
 * @file
 * Installatie en updates voor BREBO Knowledge.
 */

use Drupal\Core\Entity\Entity\EntityFormDisplay;
use Drupal\Core\Entity\Entity\EntityViewDisplay;
use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\node\Entity\NodeType;

/**
 * Implements hook_install().
 */
function brebo_knowledge_install(): void {
  $type = NodeType::load('brebo_knowledge_item');
  if (!$type) {
    $type = NodeType::create([
      'type' => 'brebo_knowledge_item',
      'name' => 'Kennisbijdrage',
      'description' => 'Probleemgerichte, revisioneerbare BREBO-kennisbijdrage.',
      'new_revision' => TRUE,
      'preview_mode' => 1,
      'display_submitted' => FALSE,
    ]);
    $type->save();
  }
  elseif (!$type->shouldCreateNewRevision()) {
    throw new RuntimeException('Contenttype brebo_knowledge_item bestaat zonder verplichte revisie-instelling. Installatie is gestopt.');
  }

  $fields = _brebo_knowledge_field_definitions();
  foreach ($fields as $field_name => $definition) {
    _brebo_knowledge_ensure_field($field_name, $definition);
  }

  _brebo_knowledge_configure_displays($fields);
}

