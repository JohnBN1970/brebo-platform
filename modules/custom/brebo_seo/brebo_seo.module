<?php

/**
 * @file
 * Technical SEO attachments for the public BREBO website.
 */

use Drupal\Core\Url;

/**
 * Implements hook_page_attachments().
 */
function brebo_seo_page_attachments(array &$attachments): void {
  if (PHP_SAPI === 'cli') {
    return;
  }

  $request = \Drupal::request();
  if (!$request->isMethodSafe()) {
    return;
  }

  $route_name = (string) \Drupal::routeMatch()->getRouteName();
  if (in_array($route_name, ['system.403', 'system.404'], TRUE)) {
    return;
  }

  $path = $request->getPathInfo();
  if (str_starts_with($path, '/admin') || str_starts_with($path, '/user')) {
    return;
  }

  // Project intake and result pages support the customer journey, but should
  // not compete with BREBO's public service pages in search results.
  $noindex_prefixes = [
    '/europakozijn/samenstellen',
    '/europakozijn/projectstukken',
  ];
  foreach ($noindex_prefixes as $prefix) {
    if ($path === $prefix || str_starts_with($path, $prefix . '/')) {
      $attachments['#attached']['html_head'][] = [
        [
          '#tag' => 'meta',
          '#attributes' => [
            'name' => 'robots',
            'content' => 'noindex,follow',
          ],
        ],
        'brebo_seo_robots',
      ];
      return;
    }
  }

  $canonical = Url::fromUserInput($path ?: '/', ['absolute' => TRUE])->toString();
  $attachments['#attached']['html_head_link'][] = [
    [
      'rel' => 'canonical',
      'href' => $canonical,
    ],
    TRUE,
  ];

  $titles = [
    '/' => 'Kozijnen en glas leveren en plaatsen | BREBO',
    '/projecten' => 'Projecten in kozijnen, glas en renovatie | BREBO',
    '/bouwbegeleiding' => 'Onafhankelijke bouwbegeleiding bij renovatie | BREBO',
  ];

  if (isset($titles[$path])) {
    $attachments['#attached']['html_head'][] = [
      [
        '#tag' => 'title',
        '#value' => $titles[$path],
      ],
      'brebo_seo_title',
    ];
  }

  $descriptions = [
    '/' => 'BREBO levert en plaatst kozijnen en glas voor onderhoud en renovatie, met technisch inzicht van voorbereiding tot uitvoering en beheer.',
    '/projecten' => 'Bekijk BREBO-projecten in onderhoud en renovatie, met focus op kozijnen, glas, technische voorbereiding en uitvoering.',
    '/bouwbegeleiding' => 'Onafhankelijke bouwbegeleiding bij onderhoud en renovatie: grip op kwaliteit, planning, afspraken, kosten, uitvoering en oplevering.',
  ];

  if (isset($descriptions[$path])) {
    $attachments['#attached']['html_head'][] = [
      [
        '#tag' => 'meta',
        '#attributes' => [
          'name' => 'description',
          'content' => $descriptions[$path],
        ],
      ],
      'brebo_seo_description',
    ];
  }

  $attachments['#attached']['html_head'][] = [
    [
      '#tag' => 'script',
      '#attributes' => ['type' => 'application/ld+json'],
      '#value' => json_encode([
        '@context' => 'https://schema.org',
        '@type' => 'Organization',
        'name' => 'BREBO Bouw en Advies BV',
        'url' => 'https://brebobv.nl/',
        'description' => 'Levering en plaatsing van kozijnen en glas, met technisch advies en begeleiding rond onderhoud en renovatie.',
      ], JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE),
    ],
    'brebo_seo_organization_schema',
  ];
}
