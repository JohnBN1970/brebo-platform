<?php

/**
 * @file
 * Technical SEO attachments for the public BREBO website.
 */

use Drupal\Core\Url;

/**
 * Returns focused SEO document titles for public landing pages.
 */
function brebo_seo_titles(): array {
  return [
    '/' => 'Kozijnen en glas leveren en plaatsen | BREBO',
    '/uw-gebouw' => 'Inzicht in uw gebouw, onderhoud en renovatie | BREBO',
    '/onderhoud-renovatie' => 'Onderhoud en renovatie van gebouwen | BREBO',
    '/projecten' => 'Projecten in kozijnen, glas en renovatie | BREBO',
    '/kennis-advies' => 'Kennis en technisch advies voor gebouwen | BREBO',
    '/bouwbegeleiding' => 'Onafhankelijke bouwbegeleiding bij renovatie | BREBO',
    '/klantenservice' => 'Klantenservice voor uw gebouw en project | BREBO',
    '/contact' => 'Contact over kozijnen, glas en renovatie | BREBO',
  ];
}

/**
 * Returns focused meta descriptions for public landing pages.
 */
function brebo_seo_descriptions(): array {
  return [
    '/' => 'BREBO levert en plaatst kozijnen en glas voor onderhoud en renovatie, met technisch inzicht van voorbereiding tot uitvoering en beheer.',
    '/uw-gebouw' => 'Krijg grip op de technische staat van uw gebouw en bepaal gericht wat nu aandacht vraagt en wat later kan.',
    '/onderhoud-renovatie' => 'BREBO ondersteunt onderhoud en renovatie van gebouwen met technisch inzicht, voorbereiding, regie en gerichte realisatie.',
    '/projecten' => 'Bekijk BREBO-projecten in onderhoud en renovatie, met focus op kozijnen, glas, technische voorbereiding en uitvoering.',
    '/kennis-advies' => 'Technische kennis en praktisch advies over kozijnen, glas, gevels, onderhoud, renovatie en de samenhang binnen uw gebouw.',
    '/bouwbegeleiding' => 'Onafhankelijke bouwbegeleiding bij onderhoud en renovatie: grip op kwaliteit, planning, afspraken, kosten, uitvoering en oplevering.',
    '/klantenservice' => 'Vind praktische informatie en ondersteuning rond uw gebouw, project, kozijnen, glas, onderhoud en uitvoering bij BREBO.',
    '/contact' => 'Neem contact op met BREBO over kozijnen en glas leveren en plaatsen, onderhoud, renovatie, bouwbegeleiding of technisch advies.',
  ];
}

/**
 * Returns page-aware schema.org data without adding unsupported claims.
 */
function brebo_seo_structured_data(string $path, string $canonical): array {
  $organization_id = 'https://brebobv.nl/#organization';

  $graph = [
    [
      '@type' => 'Organization',
      '@id' => $organization_id,
      'name' => 'BREBO Bouw en Advies BV',
      'url' => 'https://brebobv.nl/',
      'description' => 'Levering en plaatsing van kozijnen en glas, met technisch advies en begeleiding rond onderhoud en renovatie.',
    ],
  ];

  if ($path === '/') {
    $graph[] = [
      '@type' => 'WebSite',
      '@id' => 'https://brebobv.nl/#website',
      'url' => 'https://brebobv.nl/',
      'name' => 'BREBO',
      'publisher' => ['@id' => $organization_id],
    ];
    $graph[] = [
      '@type' => 'Service',
      '@id' => 'https://brebobv.nl/#kozijnen-glas-service',
      'name' => 'Kozijnen en glas leveren en plaatsen',
      'description' => 'Levering en plaatsing van kozijnen en glas voor onderhoud en renovatie.',
      'provider' => ['@id' => $organization_id],
      'url' => $canonical,
    ];
  }
  elseif ($path === '/bouwbegeleiding') {
    $graph[] = [
      '@type' => 'Service',
      '@id' => 'https://brebobv.nl/bouwbegeleiding#service',
      'name' => 'Onafhankelijke bouwbegeleiding',
      'description' => 'Bouwbegeleiding bij onderhoud en renovatie met aandacht voor kwaliteit, planning, afspraken, kosten, uitvoering en oplevering.',
      'provider' => ['@id' => $organization_id],
      'url' => $canonical,
    ];
  }

  return [
    '@context' => 'https://schema.org',
    '@graph' => $graph,
  ];
}

/**
 * Implements hook_preprocess_HOOK() for html.html.twig.
 */
function brebo_seo_preprocess_html(array &$variables): void {
  if (PHP_SAPI === 'cli') {
    return;
  }

  $request = \Drupal::request();
  if (!$request->isMethodSafe()) {
    return;
  }

  $route_name = (string) \Drupal::routeMatch()->getRouteName();
  if (in_array($route_name, ['system.403', 'system.404'], TRUE)) {
    return;
  }

  $path = $request->getPathInfo();
  $titles = brebo_seo_titles();
  if (isset($titles[$path])) {
    // Drupal renders the one document <title> from head_title. Replacing its
    // title part avoids emitting a second title element and leaves the H1
    // and other visible page content untouched.
    $variables['head_title']['title'] = $titles[$path];
    $variables['head_title']['name'] = '';
    $variables['head_title']['slogan'] = '';
  }
}

/**
 * Implements hook_page_attachments().
 */
function brebo_seo_page_attachments(array &$attachments): void {
  if (PHP_SAPI === 'cli') {
    return;
  }

  $request = \Drupal::request();
  if (!$request->isMethodSafe()) {
    return;
  }

  $route_name = (string) \Drupal::routeMatch()->getRouteName();
  if (in_array($route_name, ['system.403', 'system.404'], TRUE)) {
    return;
  }

  $path = $request->getPathInfo();
  if (str_starts_with($path, '/admin') || str_starts_with($path, '/user')) {
    return;
  }

  // Transactional customer-journey routes should remain crawlable for links,
  // but should not compete with BREBO's public landing pages in search.
  $noindex_prefixes = [
    '/europakozijn/samenstellen',
    '/europakozijn/projectstukken',
    '/contact/bericht',
  ];
  foreach ($noindex_prefixes as $prefix) {
    if ($path === $prefix || str_starts_with($path, $prefix . '/')) {
      $attachments['#attached']['html_head'][] = [
        [
          '#tag' => 'meta',
          '#attributes' => [
            'name' => 'robots',
            'content' => 'noindex,follow',
          ],
        ],
        'brebo_seo_robots',
      ];
      return;
    }
  }

  $canonical = Url::fromUserInput($path ?: '/', ['absolute' => TRUE])->toString();
  $attachments['#attached']['html_head_link'][] = [
    [
      'rel' => 'canonical',
      'href' => $canonical,
    ],
    TRUE,
  ];

  $titles = brebo_seo_titles();
  $descriptions = brebo_seo_descriptions();

  if (isset($descriptions[$path])) {
    $attachments['#attached']['html_head'][] = [
      [
        '#tag' => 'meta',
        '#attributes' => [
          'name' => 'description',
          'content' => $descriptions[$path],
        ],
      ],
      'brebo_seo_description',
    ];
  }

  // Keep social previews aligned with the same page-specific SEO signals.
  if (isset($titles[$path], $descriptions[$path])) {
    $open_graph = [
      'og:type' => 'website',
      'og:site_name' => 'BREBO',
      'og:locale' => 'nl_NL',
      'og:title' => $titles[$path],
      'og:description' => $descriptions[$path],
      'og:url' => $canonical,
    ];
    foreach ($open_graph as $property => $content) {
      $attachments['#attached']['html_head'][] = [
        [
          '#tag' => 'meta',
          '#attributes' => [
            'property' => $property,
            'content' => $content,
          ],
        ],
        'brebo_seo_' . str_replace(':', '_', $property),
      ];
    }

    $attachments['#attached']['html_head'][] = [
      [
        '#tag' => 'meta',
        '#attributes' => [
          'name' => 'twitter:card',
          'content' => 'summary',
        ],
      ],
      'brebo_seo_twitter_card',
    ];
  }

  $attachments['#attached']['html_head'][] = [
    [
      '#tag' => 'script',
      '#attributes' => ['type' => 'application/ld+json'],
      '#value' => json_encode(
        brebo_seo_structured_data($path, $canonical),
        JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE,
      ),
    ],
    'brebo_seo_structured_data',
  ];
}
