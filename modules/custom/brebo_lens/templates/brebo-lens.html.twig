<section id="brebo-lens" class="brebo-lens" data-brebo-lens>
  <div class="brebo-lens__backdrop" aria-hidden="true">
    <img class="brebo-lens__backdrop-image brebo-lens__backdrop-image--current" src="{{ initial_image_url }}" alt="" data-lens-backdrop-current>
    <img class="brebo-lens__backdrop-image brebo-lens__backdrop-image--next" src="{{ initial_image_url }}" alt="" data-lens-backdrop-next>
    <span class="brebo-lens__backdrop-wash"></span>
  </div>

  <div class="brebo-lens__container">
    <header class="brebo-lens__intro">
      <p class="brebo-lens__eyebrow">De BREBO Lens</p>
      <h2 class="brebo-lens__title">Van gebouwvraag<br>naar onderbouwde keuze.</h2>
      <p class="brebo-lens__lead">Inzicht, Regie en Realisatie vormen samen één aanpak. Niet de oplossing staat vooraf vast, maar het gebouw staat steeds centraal.</p>
    </header>

    <div class="brebo-lens__layout">
      <div class="brebo-lens__visual" aria-label="De BREBO Lens: Inzicht, Regie en Realisatie">
        <div class="brebo-lens__venn">
          {% for phase in phases %}
            <button class="brebo-lens__phase brebo-lens__phase--{{ loop.index }}{{ loop.first ? ' is-active' : '' }}" type="button" data-lens-step="{{ loop.index0 }}" data-lens-image="{{ phase.image }}" aria-pressed="{{ loop.first ? 'true' : 'false' }}">
              <span class="brebo-lens__phase-number">0{{ loop.index }}</span>
              <span class="brebo-lens__phase-icon" aria-hidden="true">
                {% if loop.index == 1 %}
                  <svg viewBox="0 0 24 24"><circle cx="10" cy="10" r="6"/><path d="m14.5 14.5 5 5"/></svg>
                {% elseif loop.index == 2 %}
                  <svg viewBox="0 0 24 24"><circle cx="8" cy="8" r="3"/><circle cx="17" cy="9" r="2.5"/><path d="M2.5 20c.4-4 2.3-6 5.5-6s5.1 2 5.5 6M14 15c3.6-.5 6 .9 7 4"/></svg>
                {% else %}
                  <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><path d="m8.5 12 2.2 2.2 4.8-5"/></svg>
                {% endif %}
              </span>
              <strong>{{ phase.title }}</strong>
              <small>{{ phase.subtitle }}</small>
            </button>
          {% endfor %}

          <div class="brebo-lens__core" aria-hidden="true">
            <div class="brebo-lens__core-photo">
              <img class="brebo-lens__glass-photo brebo-lens__glass-photo--current" src="{{ initial_image_url }}" alt="" data-lens-photo-current>
              <img class="brebo-lens__glass-photo brebo-lens__glass-photo--next" src="{{ initial_image_url }}" alt="" data-lens-photo-next>
            </div>
            <div class="brebo-lens__motto"><span>Het gebouw</span><strong>staat centraal.</strong></div>
          </div>
        </div>

        <p class="brebo-lens__hint" style="margin-top:2.75rem;"><span aria-hidden="true">☝</span>Klik op een fase om te zien hoe we samen stap voor stap werken aan de beste oplossing voor uw gebouw.</p>
      </div>

      <aside class="brebo-lens__panel" aria-live="polite" aria-atomic="true">
        <div class="brebo-lens__panel-content">
          {% for phase in phases %}
            <article class="brebo-lens__panel-step{{ loop.first ? ' is-active' : '' }}" data-lens-panel="{{ loop.index0 }}" {% if not loop.first %}hidden{% endif %}>
              <p class="brebo-lens__panel-number">{{ phase.number }}</p>
              <h3>{{ phase.title }}</h3>
              <p class="brebo-lens__panel-subtitle">{{ phase.subtitle }}</p>
              <span class="brebo-lens__panel-accent" aria-hidden="true"></span>
              <p class="brebo-lens__panel-text">{{ phase.text }}</p>
              <ul>{% for point in phase.points %}<li>{{ point }}</li>{% endfor %}</ul>
            </article>
          {% endfor %}
        </div>
        <div class="brebo-lens__panel-nav">
          <button type="button" class="brebo-lens__nav brebo-lens__nav--prev" aria-label="Vorige fase">←</button>
          <button type="button" class="brebo-lens__nav brebo-lens__nav--next" aria-label="Volgende fase">→</button>
        </div>
        <div class="brebo-lens__dots" aria-hidden="true"><span class="is-active"></span><span></span><span></span></div>
      </aside>
    </div>

    <section id="brebo-journey" class="brebo-journey" data-brebo-journey aria-labelledby="brebo-journey-title">
      <div class="brebo-journey__intro">
        <p class="brebo-lens__eyebrow">Uw gebouw</p>
        <h2 id="brebo-journey-title">Waar kunnen we u mee helpen?</h2>
        <p>U hoeft vooraf niet te weten welke oplossing of dienst nodig is. Kies wat het dichtst bij uw situatie komt; wij leiden u van daaruit verder.</p>
      </div>

      <div class="brebo-journey__progress" aria-label="Voortgang">
        <span class="is-active" data-journey-progress="1">1. Uw vraag</span>
        <span data-journey-progress="2">2. De situatie</span>
        <span data-journey-progress="3">3. Uw gebouw</span>
      </div>

      <div class="brebo-journey__step is-active" data-journey-step="1">
        <div class="brebo-journey__choices" role="group" aria-label="Wat speelt er bij uw gebouw?">
          <button type="button" class="brebo-journey__choice" data-journey-route="orientatie"><strong>Ik weet nog niet wat er nodig is</strong><span>Er speelt iets aan het gebouw, maar de juiste aanpak is nog niet duidelijk.</span></button>
          <button type="button" class="brebo-journey__choice" data-journey-route="probleem"><strong>Ik heb een concreet onderhoudsprobleem</strong><span>Er is schade, lekkage, tocht, slijtage of een ander zichtbaar probleem.</span></button>
          <button type="button" class="brebo-journey__choice" data-journey-route="kozijnen-glas"><strong>Ik wil kozijnen of glas aanpakken</strong><span>Vervangen, verbeteren of eerst vaststellen wat technisch nodig is.</span></button>
          <button type="button" class="brebo-journey__choice" data-journey-route="documenten"><strong>Ik heb al plannen of documenten</strong><span>Bijvoorbeeld een MJOP, rapport, tekening, kozijnstaat of offerte.</span></button>
          <button type="button" class="brebo-journey__choice" data-journey-route="bouwbegeleiding"><strong>Ik zoek begeleiding bij een project</strong><span>Van voorbereiding en inkoop tot toezicht, oplevering en nazorg.</span></button>
        </div>
      </div>

      <div class="brebo-journey__step" data-journey-step="2" hidden>
        <div class="brebo-journey__step-head">
          <button type="button" class="brebo-journey__back" data-journey-back="1">← Terug</button>
          <p class="brebo-journey__question" data-journey-question>Wat past het beste bij uw situatie?</p>
        </div>
        <div class="brebo-journey__choices brebo-journey__choices--context" data-journey-contexts></div>
      </div>

      <div class="brebo-journey__step" data-journey-step="3" hidden>
        <div class="brebo-journey__step-head">
          <button type="button" class="brebo-journey__back" data-journey-back="2">← Terug</button>
          <p class="brebo-journey__question">Dit nemen we mee naar uw eerste contact.</p>
        </div>
        <div class="brebo-journey__summary" aria-live="polite">
          <div><span>Uw vraag</span><strong data-journey-route-summary></strong></div>
          <div><span>Situatie</span><strong data-journey-context-summary></strong></div>
        </div>
        <div class="brebo-journey__next">
          <p>Vertel ons nu alleen nog om welk gebouw het gaat en hoe we u kunnen bereiken. U hoeft uw technische oplossing nog niet zelf te bepalen.</p>
          <a class="brebo-journey__cta" href="/contact/bericht" data-journey-cta>Verder met mijn gebouw <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>
  </div>
</section>
