<?php

/**
 * @file
 * Installatie en updates voor BREBO Taxonomy.
 */

use Drupal\Core\Entity\Entity\EntityFormDisplay;
use Drupal\Core\Entity\Entity\EntityViewDisplay;
use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\node\Entity\NodeType;
use Drupal\taxonomy\Entity\Term;
use Drupal\taxonomy\Entity\Vocabulary;

/**
 * Implements hook_install().
 */
function brebo_taxonomy_install(): void {
  if (!NodeType::load('dienst')) {
    throw new RuntimeException('Contenttype "dienst" bestaat niet. BREBO Taxonomy is niet geïnstalleerd.');
  }

  $vocabularies = _brebo_taxonomy_definitions();

  foreach ($vocabularies as $vid => $definition) {
    _brebo_taxonomy_ensure_vocabulary($vid, $definition['label']);
    _brebo_taxonomy_ensure_terms($vid, $definition['terms']);
    _brebo_taxonomy_ensure_reference_field(
      $definition['field_name'],
      $definition['field_label'],
      $definition['field_description'],
      $vid,
      $definition['weight'],
    );
  }
}

