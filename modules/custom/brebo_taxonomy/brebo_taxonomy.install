/**
 * Creates a vocabulary only when it does not exist.
 */
function _brebo_taxonomy_ensure_vocabulary(string $vid, string $label): void {
  if (Vocabulary::load($vid)) {
    return;
  }

  Vocabulary::create([
    'vid' => $vid,
    'name' => $label,
  ])->save();
}

/**
 * Adds only missing terms and leaves existing terms untouched.
 */
function _brebo_taxonomy_ensure_terms(string $vid, array $term_names): void {
  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');

  foreach ($term_names as $term_name) {
    $existing = $storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('vid', $vid)
      ->condition('name', $term_name)
      ->range(0, 1)
      ->execute();

    if ($existing) {
      continue;
    }

    Term::create([
      'vid' => $vid,
      'name' => $term_name,
    ])->save();
  }
}

/**
 * Adds an entity-reference field without replacing existing configuration.
 */
function _brebo_taxonomy_ensure_reference_field(
  string $field_name,
  string $label,
  string $description,
  string $vid,
  int $weight,
): void {
  $storage = FieldStorageConfig::loadByName('node', $field_name);

  if (!$storage) {
    $storage = FieldStorageConfig::create([
      'field_name' => $field_name,
      'entity_type' => 'node',
      'type' => 'entity_reference',
      'cardinality' => -1,
      'settings' => [
        'target_type' => 'taxonomy_term',
      ],
      'translatable' => TRUE,
    ]);
    $storage->save();
  }
  elseif ($storage->getType() !== 'entity_reference' || $storage->getSetting('target_type') !== 'taxonomy_term') {
    \Drupal::logger('brebo_taxonomy')->warning(
      'Veldopslag @field bestaat al met een afwijkend type en is daarom niet gewijzigd.',
      ['@field' => $field_name],
    );
    return;
  }

  $field = FieldConfig::loadByName('node', 'dienst', $field_name);
  if (!$field) {
    FieldConfig::create([
      'field_storage' => $storage,
      'bundle' => 'dienst',
      'label' => $label,
      'description' => $description,
      'required' => FALSE,
      'translatable' => TRUE,
      'settings' => [
        'handler' => 'default:taxonomy_term',
        'handler_settings' => [
          'target_bundles' => [$vid => $vid],
          'sort' => ['field' => 'name', 'direction' => 'asc'],
          'auto_create' => FALSE,
          'auto_create_bundle' => '',
        ],
      ],
    ])->save();
  }

  _brebo_taxonomy_add_to_displays($field_name, $weight);
}

/**
 * Adds a field to displays only when no component exists yet.
 */
function _brebo_taxonomy_add_to_displays(string $field_name, int $weight): void {
  $form_display = EntityFormDisplay::load('node.dienst.default')
    ?: EntityFormDisplay::create([
      'targetEntityType' => 'node',
      'bundle' => 'dienst',
      'mode' => 'default',
      'status' => TRUE,
    ]);

  if (!$form_display->getComponent($field_name)) {
    $form_display->setComponent($field_name, [
      'type' => 'options_select',
      'weight' => $weight,
    ]);
    $form_display->save();
  }

  $view_display = EntityViewDisplay::load('node.dienst.full')
    ?: EntityViewDisplay::create([
      'targetEntityType' => 'node',
      'bundle' => 'dienst',
      'mode' => 'full',
      'status' => TRUE,
    ]);

  if (!$view_display->getComponent($field_name)) {
    $view_display->setComponent($field_name, [
      'type' => 'entity_reference_label',
      'label' => 'above',
      'weight' => $weight,
      'settings' => ['link' => FALSE],
    ]);
    $view_display->save();
  }
}
