{%
  set classes = [
    'node',
    'node--type-' ~ node.bundle|clean_class,
    node.isPromoted() ? 'node--promoted',
    node.isSticky() ? 'node--sticky',
    not node.isPublished() ? 'node--unpublished',
    view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
    'brebo-inner-page'
  ]
%}
<article{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {% if label and not page %}
    <h2{{ title_attributes }}>
      <a href="{{ url }}" rel="bookmark">{{ label }}</a>
    </h2>
  {% endif %}
  {{ title_suffix }}

  {% if page and is_uw_gebouw_page %}
    <section class="brebo-building-route" aria-labelledby="brebo-building-route-title">
      <div class="site-container">
        <p class="brebo-building-route__eyebrow">{{ 'Uw beslisroute'|t }}</p>
        <h2 id="brebo-building-route-title">{{ 'Van eerste signaal naar een beheerste aanpak.'|t }}</h2>
        <div class="brebo-building-route__grid">
          <div><span>01</span><strong>{{ 'Wat ziet of ervaart u?'|t }}</strong></div>
          <div><span>02</span><strong>{{ 'Wat is de oorzaak?'|t }}</strong></div>
          <div><span>03</span><strong>{{ 'Wat moet eerst?'|t }}</strong></div>
          <div><span>04</span><strong>{{ 'Wat kan worden gepland?'|t }}</strong></div>
          <div><span>05</span><strong>{{ 'Hoe houdt u grip?'|t }}</strong></div>
        </div>
      </div>
    </section>
  {% endif %}

  <div{{ content_attributes.addClass('brebo-inner-page__content', 'site-container') }}>
    {{ content|without('links') }}
  </div>

  {% if page %}
    <section class="brebo-inner-page__cta" aria-labelledby="brebo-page-cta-title">
      <div class="site-container brebo-inner-page__cta-inner">
        <div>
          <p class="brebo-inner-page__cta-eyebrow">{{ 'Uw gebouw centraal'|t }}</p>
          <h2 id="brebo-page-cta-title">{{ 'Bespreek wat uw gebouw nodig heeft.'|t }}</h2>
        </div>
        <a class="button button--primary" href="/contact">{{ 'Neem contact op'|t }}</a>
      </div>
    </section>
  {% endif %}
</article>
