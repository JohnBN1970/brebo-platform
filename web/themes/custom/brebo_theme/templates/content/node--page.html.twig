{%
  set classes = [
    'node',
    'node--type-' ~ node.bundle|clean_class,
    node.isPromoted() ? 'node--promoted',
    node.isSticky() ? 'node--sticky',
    not node.isPublished() ? 'node--unpublished',
    view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
    'brebo-inner-page'
  ]
%}
<article{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {% if label and not page %}
    <h2{{ title_attributes }}>
      <a href="{{ url }}" rel="bookmark">{{ label }}</a>
    </h2>
  {% endif %}
  {{ title_suffix }}

  <div{{ content_attributes.addClass('brebo-inner-page__content', 'site-container') }}>
    {{ content|without('links') }}
  </div>

  {% if page %}
    <section class="brebo-inner-page__cta" aria-labelledby="brebo-page-cta-title">
      <div class="site-container brebo-inner-page__cta-inner">
        <div>
          <p class="brebo-inner-page__cta-eyebrow">{{ 'Uw gebouw centraal'|t }}</p>
          <h2 id="brebo-page-cta-title">{{ 'Bespreek wat uw gebouw nodig heeft.'|t }}</h2>
        </div>
        <a class="button button--primary" href="/contact">{{ 'Neem contact op'|t }}</a>
      </div>
    </section>
  {% endif %}
</article>
