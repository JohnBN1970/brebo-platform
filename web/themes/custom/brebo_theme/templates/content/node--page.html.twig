{%
  set classes = [
    'node',
    'node--type-' ~ node.bundle|clean_class,
    node.isPromoted() ? 'node--promoted',
    node.isSticky() ? 'node--sticky',
    not node.isPublished() ? 'node--unpublished',
    view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
    'brebo-inner-page'
  ]
%}
<article{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {% if label and not page %}
    <h2{{ title_attributes }}>
      <a href="{{ url }}" rel="bookmark">{{ label }}</a>
    </h2>
  {% endif %}
  {{ title_suffix }}

  {% if page and is_uw_gebouw_page %}
    <section class="brebo-building-route" aria-labelledby="brebo-building-route-title">
      <div class="site-container">
        <p class="brebo-building-route__eyebrow">{{ 'Uw beslisroute'|t }}</p>
        <h2 id="brebo-building-route-title">{{ 'Van eerste signaal naar een beheerste aanpak.'|t }}</h2>
        <div class="brebo-building-route__grid">
          <div><span>01</span><strong>{{ 'Wat ziet of ervaart u?'|t }}</strong></div>
          <div><span>02</span><strong>{{ 'Wat is de oorzaak?'|t }}</strong></div>
          <div><span>03</span><strong>{{ 'Wat moet eerst?'|t }}</strong></div>
          <div><span>04</span><strong>{{ 'Wat kan worden gepland?'|t }}</strong></div>
          <div><span>05</span><strong>{{ 'Hoe houdt u grip?'|t }}</strong></div>
        </div>
      </div>
    </section>
  {% endif %}

  {% if page and is_diensten_page %}
    <section class="brebo-support-route" aria-labelledby="brebo-support-route-title">
      <div class="site-container">
        <p class="brebo-support-route__eyebrow">{{ 'Wat heeft uw gebouw nodig?'|t }}</p>
        <h2 id="brebo-support-route-title">{{ 'Niet iedere gebouwvraag vraagt om dezelfde rol.'|t }}</h2>
        <p class="brebo-support-route__intro">{{ 'Soms is eerst onderzoek of advies nodig. Soms vooral regie. En soms is de maatregel al duidelijk en gaat het om goede uitvoering. De juiste ondersteuning volgt uit de gebouwvraag, niet andersom.'|t }}</p>
        <div class="brebo-support-route__grid">
          <article>
            <span>01</span>
            <h3>{{ 'Eerst duidelijkheid krijgen'|t }}</h3>
            <p>{{ 'Wanneer oorzaak, omvang, risico of onderhoudsbehoefte nog niet voldoende vaststaat.'|t }}</p>
          </article>
          <article>
            <span>02</span>
            <h3>{{ 'De aanpak organiseren'|t }}</h3>
            <p>{{ 'Wanneer keuzes, scope, planning, kosten en betrokken partijen beheerst op elkaar moeten aansluiten.'|t }}</p>
          </article>
          <article>
            <span>03</span>
            <h3>{{ 'De maatregel realiseren'|t }}</h3>
            <p>{{ 'Wanneer helder is wat nodig is en uitvoering aantoonbaar volgens afspraak moet plaatsvinden.'|t }}</p>
          </article>
        </div>
      </div>
    </section>
  {% endif %}

  {% if page and is_voor_wie_page %}
    <section class="brebo-responsibility-route" aria-labelledby="brebo-responsibility-route-title">
      <div class="site-container">
        <p class="brebo-responsibility-route__eyebrow">{{ 'Uw verantwoordelijkheid'|t }}</p>
        <h2 id="brebo-responsibility-route-title">{{ 'U moet beslissingen nemen over een gebouw. Daar begint het.'|t }}</h2>
        <p class="brebo-responsibility-route__intro">{{ 'Of u nu eigenaar, beheerder, bestuurder of opdrachtgever bent: u wilt kunnen uitleggen waarom een maatregel nodig is, waarom die nu moet en wat die betekent voor risico, kosten, gebruik en lange termijn.'|t }}</p>
        <div class="brebo-responsibility-route__grid">
          <article>
            <span>01</span>
            <h3>{{ 'U bent verantwoordelijk voor de technische staat'|t }}</h3>
            <p>{{ 'U wilt weten wat er speelt, welke risico’s aanwezig zijn en welke onderhoudsbehoefte werkelijk bestaat.'|t }}</p>
          </article>
          <article>
            <span>02</span>
            <h3>{{ 'U moet keuzes en budget kunnen onderbouwen'|t }}</h3>
            <p>{{ 'U wilt onderscheid kunnen maken tussen urgent, noodzakelijk en planbaar werk, met zicht op gevolgen en kosten.'|t }}</p>
          </article>
          <article>
            <span>03</span>
            <h3>{{ 'U wilt grip houden op het vervolg'|t }}</h3>
            <p>{{ 'U wilt duidelijkheid over scope, planning, kwaliteit, verantwoordelijkheid en het aantoonbare resultaat.'|t }}</p>
          </article>
        </div>
      </div>
    </section>
  {% endif %}

  {% if page and is_projecten_page %}
    <section class="brebo-support-route" aria-labelledby="brebo-project-proof-title">
      <div class="site-container">
        <p class="brebo-support-route__eyebrow">{{ 'Praktijk als bewijs'|t }}</p>
        <h2 id="brebo-project-proof-title">{{ 'Een project is pas interessant als u ziet waarom een keuze werkte.'|t }}</h2>
        <p class="brebo-support-route__intro">{{ 'Daarom kijken we niet alleen naar het eindbeeld. Relevanter is welke gebouwvraag er lag, welke feiten en risico’s bepalend waren, welke maatregel is gekozen en wat die keuze aantoonbaar heeft opgeleverd.'|t }}</p>
        <div class="brebo-support-route__grid">
          <article>
            <span>01</span>
            <h3>{{ 'Wat was de gebouwvraag?'|t }}</h3>
            <p>{{ 'Welke klacht, onderhoudsbehoefte, risico of ambitie vormde het vertrekpunt?'|t }}</p>
          </article>
          <article>
            <span>02</span>
            <h3>{{ 'Welke afweging is gemaakt?'|t }}</h3>
            <p>{{ 'Waarom werd deze aanpak gekozen en welke alternatieven, risico’s, kosten en belangen speelden mee?'|t }}</p>
          </article>
          <article>
            <span>03</span>
            <h3>{{ 'Wat leverde het op?'|t }}</h3>
            <p>{{ 'Het resultaat moet herkenbaar zijn voor gebouw, gebruiker en opdrachtgever — technisch én organisatorisch.'|t }}</p>
          </article>
        </div>
      </div>
    </section>
  {% endif %}

  <div{{ content_attributes.addClass('brebo-inner-page__content', 'site-container') }}>
    {{ content|without('links') }}
  </div>

  {% if page %}
    <section class="brebo-inner-page__cta" aria-labelledby="brebo-page-cta-title">
      <div class="site-container brebo-inner-page__cta-inner">
        <div>
          <p class="brebo-inner-page__cta-eyebrow">{{ 'Uw gebouw centraal'|t }}</p>
          <h2 id="brebo-page-cta-title">{{ 'Bespreek wat uw gebouw nodig heeft.'|t }}</h2>
        </div>
        <a class="button button--primary" href="/contact">{{ 'Neem contact op'|t }}</a>
      </div>
    </section>
  {% endif %}
</article>
