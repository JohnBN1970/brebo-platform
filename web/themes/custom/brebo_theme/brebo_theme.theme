<?php

/**
 * @file
 * Theme hooks and preprocess functions for BREBO Theme.
 */

/**
 * Implements hook_preprocess_page().
 */
function brebo_theme_preprocess_page(array &$variables): void {
  $route_name = \Drupal::routeMatch()->getRouteName();
  $variables['is_not_found_page'] = $route_name === 'system.404';
}

/**
 * Implements hook_page_attachments().
 */
function brebo_theme_page_attachments(array &$attachments): void {
  $route_name = \Drupal::routeMatch()->getRouteName();

  if ($route_name === 'system.404') {
    $attachments['#attached']['html_head'][] = [
      [
        '#tag' => 'meta',
        '#attributes' => [
          'name' => 'robots',
          'content' => 'noindex, nofollow',
        ],
      ],
      'brebo_404_robots',
    ];

    return;
  }

  $path = rtrim(\Drupal::service('path.current')->getPath(), '/');
  $alias = $path === '' ? '/' : rtrim(\Drupal::service('path_alias.manager')->getAliasByPath($path), '/');
  $alias = $alias === '' ? '/' : $alias;

  $descriptions = [
    '/' => 'Krijg inzicht in wat er aan uw gebouw speelt, welke keuzes nodig zijn en hoe u grip houdt op onderhoud, renovatie en uitvoering.',
    '/uw-gebouw' => 'Van eerste signaal naar een beheerste aanpak: begrijp oorzaak, risico, prioriteit, planning en vervolgstappen voor uw gebouw.',
    '/brebo-lens' => 'De BREBO Lens helpt u van inzicht naar regie en realisatie, zodat beslissingen over uw gebouw onderbouwd en beheerst worden genomen.',
    '/diensten' => 'Welke ondersteuning heeft uw gebouw nodig? Van onderzoek en advies tot regie en uitvoering, passend bij de werkelijke gebouwvraag.',
    '/voor-wie' => 'Voor eigenaren, beheerders en opdrachtgevers die technische keuzes, budget, planning en kwaliteit rond hun gebouw willen kunnen onderbouwen.',
    '/projecten' => 'Bekijk praktijkvoorbeelden vanuit de gebouwvraag, gemaakte afweging, gekozen aanpak en het aantoonbare resultaat.',
    '/over-brebo' => 'Lees wat u van BREBO mag verwachten bij onderhoud en renovatie: uitlegbaar advies, heldere rollen en aantoonbaar resultaat.',
    '/kennis' => 'Technische kennis die helpt om gebouwsignalen, oorzaken, risico’s en relevante vervolgstappen beter te begrijpen.',
    '/contact' => 'Bespreek uw gebouwvraag met BREBO. U hoeft de oorzaak of oplossing nog niet te kennen om te beginnen.',
  ];

  if (isset($descriptions[$alias])) {
    $attachments['#attached']['html_head'][] = [
      [
        '#tag' => 'meta',
        '#attributes' => [
          'name' => 'description',
          'content' => $descriptions[$alias],
        ],
      ],
      'brebo_meta_description',
    ];
  }
}

/**
 * Implements hook_preprocess_node().
 */
function brebo_theme_preprocess_node(array &$variables): void {
  $node = $variables['node'] ?? NULL;

  if (!$node) {
    return;
  }

  if (
    $node->bundle() === 'dienst' &&
    ($variables['view_mode'] ?? '') === 'full'
  ) {
    $variables['#attached']['library'][] = 'brebo_theme/service-detail';
  }

  if (
    $node->bundle() === 'page' &&
    ($variables['view_mode'] ?? '') === 'full'
  ) {
    $system_path = '/node/' . $node->id();
    $alias = rtrim(\Drupal::service('path_alias.manager')->getAliasByPath($system_path), '/');
    $variables['is_uw_gebouw_page'] = $alias === '/uw-gebouw';
    $variables['is_diensten_page'] = $alias === '/diensten';
    $variables['is_voor_wie_page'] = $alias === '/voor-wie';
    $variables['is_projecten_page'] = $alias === '/projecten';
    $variables['is_over_brebo_page'] = $alias === '/over-brebo';
    $variables['is_kennis_page'] = $alias === '/kennis';
    $variables['is_contact_page'] = $alias === '/contact';
  }
}
