/**
 * Maakt veldopslag en veldinstantie conflictveilig aan.
 */
function _brebo_reference_ensure_field(string $field_name, array $definition): void {
  $storage = FieldStorageConfig::loadByName('node', $field_name);
  $cardinality = $definition['cardinality'] ?? 1;

  if (!$storage) {
    $storage = FieldStorageConfig::create([
      'field_name' => $field_name,
      'entity_type' => 'node',
      'type' => $definition['type'],
      'cardinality' => $cardinality,
      'settings' => $definition['settings'] ?? [],
      'translatable' => TRUE,
    ]);
    $storage->save();
  }
  elseif ($storage->getType() !== $definition['type'] || $storage->getCardinality() !== $cardinality) {
    throw new RuntimeException(sprintf('Conflicterende veldopslag voor %s. Installatie is gestopt.', $field_name));
  }

  $field = FieldConfig::loadByName('node', 'brebo_reference', $field_name);
  if (!$field) {
    $field = FieldConfig::create([
      'field_storage' => $storage,
      'bundle' => 'brebo_reference',
      'label' => $definition['label'],
      'description' => $definition['description'],
      'required' => $definition['required'],
      'translatable' => TRUE,
      'default_value' => $definition['default_value'] ?? [],
    ]);
    $field->save();
  }
}

/**
 * Richt redactionele en volledige weergave in.
 */
function _brebo_reference_configure_displays(array $fields): void {
  $form_display = EntityFormDisplay::load('node.brebo_reference.default')
    ?: EntityFormDisplay::create([
      'targetEntityType' => 'node',
      'bundle' => 'brebo_reference',
      'mode' => 'default',
      'status' => TRUE,
    ]);

  $view_display = EntityViewDisplay::load('node.brebo_reference.default')
    ?: EntityViewDisplay::create([
      'targetEntityType' => 'node',
      'bundle' => 'brebo_reference',
      'mode' => 'default',
      'status' => TRUE,
    ]);

  foreach ($fields as $field_name => $definition) {
    $form_display->setComponent($field_name, $definition['form']);
    $view_display->setComponent($field_name, $definition['view']);
  }

  $form_display->save();
  $view_display->save();
}
