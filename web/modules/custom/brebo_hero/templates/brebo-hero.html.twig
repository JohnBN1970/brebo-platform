{#
/**
 * @file
 * Vaste homepagehero voor BREBO.
 */
#}
<section class="brebo-hero" aria-labelledby="brebo-hero-title">
  <picture class="brebo-hero__media" aria-hidden="true">
    <source media="(max-width: 47.99rem)" srcset="{{ mobile_image_url }}">
    <img
      src="{{ desktop_image_url }}"
      alt=""
      width="1664"
      height="936"
      decoding="async"
      fetchpriority="high">
  </picture>

  <div class="brebo-hero__fade" aria-hidden="true"></div>

  <div class="brebo-hero__inner">
    <div class="brebo-hero__content">
      <p class="brebo-hero__eyebrow">Uw gebouw centraal</p>

      <h1 id="brebo-hero-title" class="brebo-hero__title">
        Wat speelt er aan uw gebouw?
      </h1>

      <p class="brebo-hero__lead">
        U wilt weten wat er werkelijk aan de hand is, wat eerst aandacht vraagt en wat kan worden gepland. BREBO helpt om feiten, oorzaak, risico, maatregelen, planning en uitvoering in samenhang te beoordelen, zodat u onderbouwd kunt beslissen en grip houdt op het vervolg.
      </p>

      <div class="brebo-hero__actions">
        <a class="brebo-hero__button brebo-hero__button--primary" href="/uw-gebouw">
          Bekijk uw gebouwvraag
          <span aria-hidden="true">→</span>
        </a>

        <a class="brebo-hero__button brebo-hero__button--secondary" href="/brebo-lens">
          Hoe krijgt u grip?
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>
