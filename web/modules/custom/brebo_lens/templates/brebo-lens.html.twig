<section class="brebo-lens" data-brebo-lens>
  <div class="brebo-lens__backdrop" aria-hidden="true">
    <img class="brebo-lens__backdrop-image brebo-lens__backdrop-image--current" src="{{ initial_image_url }}" alt="" data-lens-backdrop-current>
    <img class="brebo-lens__backdrop-image brebo-lens__backdrop-image--next" src="{{ initial_image_url }}" alt="" data-lens-backdrop-next>
    <span class="brebo-lens__backdrop-wash"></span>
  </div>

  <div class="brebo-lens__container">
    <header class="brebo-lens__intro">
      <p class="brebo-lens__eyebrow">De BREBO Lens</p>
      <h2 class="brebo-lens__title">Van gebouwvraag<br>naar onderbouwde keuze.</h2>
      <p class="brebo-lens__lead">Inzicht, Regie en Realisatie vormen samen één aanpak. Niet de oplossing staat vooraf vast, maar het gebouw staat steeds centraal.</p>
    </header>

    <div class="brebo-lens__layout">
      <div class="brebo-lens__visual" aria-label="De BREBO Lens: Inzicht, Regie en Realisatie">
        <div class="brebo-lens__venn">
          {% for phase in phases %}
            <button class="brebo-lens__phase brebo-lens__phase--{{ loop.index }}{{ loop.first ? ' is-active' : '' }}" type="button" data-lens-step="{{ loop.index0 }}" data-lens-image="{{ phase.image }}" aria-pressed="{{ loop.first ? 'true' : 'false' }}">
              <span class="brebo-lens__phase-number">0{{ loop.index }}</span>
              <strong>{{ phase.title }}</strong>
              <small>{{ phase.subtitle }}</small>
            </button>
          {% endfor %}

          <div class="brebo-lens__core" aria-hidden="true">
            <div class="brebo-lens__core-photo">
              <img class="brebo-lens__glass-photo brebo-lens__glass-photo--current" src="{{ initial_image_url }}" alt="" data-lens-photo-current>
              <img class="brebo-lens__glass-photo brebo-lens__glass-photo--next" src="{{ initial_image_url }}" alt="" data-lens-photo-next>
            </div>
            <div class="brebo-lens__motto"><span>Het gebouw</span><strong>staat centraal.</strong></div>
          </div>
        </div>
      </div>

      <aside class="brebo-lens__panel" aria-live="polite" aria-atomic="true">
        <div class="brebo-lens__panel-content">
          {% for phase in phases %}
            <article class="brebo-lens__panel-step{{ loop.first ? ' is-active' : '' }}" data-lens-panel="{{ loop.index0 }}" {% if not loop.first %}hidden{% endif %}>
              <p class="brebo-lens__panel-number">{{ phase.number }}</p>
              <h3>{{ phase.title }}</h3>
              <p class="brebo-lens__panel-subtitle">{{ phase.subtitle }}</p>
              <span class="brebo-lens__panel-accent" aria-hidden="true"></span>
              <p class="brebo-lens__panel-text">{{ phase.text }}</p>
              <ul>{% for point in phase.points %}<li>{{ point }}</li>{% endfor %}</ul>
            </article>
          {% endfor %}
        </div>
        <div class="brebo-lens__panel-nav">
          <button type="button" class="brebo-lens__nav brebo-lens__nav--prev" aria-label="Vorige fase">←</button>
          <button type="button" class="brebo-lens__nav brebo-lens__nav--next" aria-label="Volgende fase">→</button>
        </div>
      </aside>
    </div>
  </div>
</section>
