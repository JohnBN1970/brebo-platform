<?php

/**
 * @file
 * Theme hooks voor de BREBO Lens-module.
 */

/**
 * Implements hook_theme().
 */
function brebo_lens_theme($existing, $type, $theme, $path): array {
  return [
    'brebo_lens' => [
      'variables' => [
        'image_url' => NULL,
        'initial_image_url' => NULL,
        'steps' => [],
      ],
      'template' => 'brebo-lens',
    ],
  ];
}
