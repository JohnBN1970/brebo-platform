<section class="brebo-projects" aria-labelledby="brebo-projects-title">
  <div class="brebo-projects__inner">
    <header class="brebo-projects__header">
      <p class="brebo-projects__eyebrow">Besluiten in de praktijk</p>
      <h2 class="brebo-projects__title" id="brebo-projects-title">
        Niet wat wij maakten.<br>
        Maar waarom deze keuze werkte.
      </h2>
      <p class="brebo-projects__intro">
        Een goed project begint niet bij uitvoering, maar bij een onderbouwde keuze. Deze praktijkvoorbeelden laten zien wat er aan het gebouw speelde, welke afweging voor de opdrachtgever doorslaggevend was en wat daarna aantoonbaar werd bereikt.
      </p>
    </header>

    <div class="brebo-projects__list">
      {% for project in projects %}
        <article class="brebo-project {{ loop.index is even ? 'brebo-project--reverse' : '' }}">
          <a class="brebo-project__media" href="{{ project.url }}" aria-label="Bekijk praktijkvoorbeeld {{ project.title }}">
            {% if project.image_url %}
              <img src="{{ project.image_url }}" alt="{{ project.image_alt }}" loading="lazy">
            {% else %}
              <span class="brebo-project__image-placeholder" aria-hidden="true"></span>
            {% endif %}
          </a>

          <div class="brebo-project__content">
            <div class="brebo-project__pillars" aria-label="Rol binnen dit project">
              <span class="brebo-project__pillar {{ project.pillars.insight ? 'is-active' : '' }}">
                <span class="brebo-project__pillar-dot" aria-hidden="true">◉</span>
                Inzicht
              </span>
              <span class="brebo-project__pillar {{ project.pillars.regie ? 'is-active' : '' }}">
                <span class="brebo-project__pillar-dot" aria-hidden="true">◉</span>
                Regie
              </span>
              <span class="brebo-project__pillar {{ project.pillars.realisatie ? 'is-active' : '' }}">
                <span class="brebo-project__pillar-dot" aria-hidden="true">◉</span>
                Realisatie
              </span>
            </div>

            <div class="brebo-project__body">
              <div class="brebo-project__question">
                <p class="brebo-project__label">Wat speelde er aan het gebouw?</p>
                <h3 class="brebo-project__heading">
                  {{ project.question ?: project.title }}
                </h3>
              </div>

              <div class="brebo-project__columns">
                <div>
                  <p class="brebo-project__label">Waarom deze keuze?</p>
                  <p class="brebo-project__text">{{ project.approach }}</p>
                </div>

                {% if project.results %}
                  <div>
                    <p class="brebo-project__label">Wat leverde dat aantoonbaar op?</p>
                    <ul class="brebo-project__results">
                      {% for result in project.results %}
                        <li>{{ result }}</li>
                      {% endfor %}
                    </ul>
                  </div>
                {% endif %}
              </div>
            </div>

            <a class="brebo-project__link" href="{{ project.url }}">
              Bekijk de afweging en het resultaat
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </article>
      {% endfor %}
    </div>

    <div class="brebo-projects__footer">
      <a class="brebo-projects__all" href="{{ projects_url }}">
        Bekijk meer praktijkvoorbeelden
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
